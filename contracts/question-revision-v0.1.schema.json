{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "question": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    },
    "importance": {
      "type": "string",
      "maxLength": 4000
    },
    "priority": {
      "type": "integer",
      "minimum": 1,
      "maximum": 4
    },
    "status": {
      "type": "string",
      "enum": [
        "open",
        "searching",
        "waiting_for_pdf",
        "analyzing",
        "answered",
        "unresolved",
        "rejected",
        "low_priority"
      ]
    },
    "conclusion": {
      "type": "string",
      "maxLength": 8000
    },
    "review_state": {
      "type": "string",
      "enum": [
        "unreviewed",
        "human_reviewed",
        "human_corrected"
      ]
    },
    "result_id": {
      "anyOf": [
        {
          "type": "string",
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
        },
        {
          "type": "null"
        }
      ]
    },
    "evidence_versions": {
      "maxItems": 20,
      "type": "array",
      "items": {
        "type": "string",
        "format": "uuid",
        "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
      }
    },
    "reason": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    }
  },
  "required": [
    "question",
    "importance",
    "priority",
    "status",
    "conclusion",
    "review_state",
    "result_id",
    "evidence_versions",
    "reason"
  ],
  "additionalProperties": false
}
