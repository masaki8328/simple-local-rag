# Public connection settings only. Fill a local ignored .env.local after project approval.
# Never place a secret/service-role key here or in any NEXT_PUBLIC variable.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only Drive configuration. Keep disabled until migrations, restricted logins
# and user-entered secrets are ready. Preview deployments always disable Drive.
KG_DRIVE_ENABLED=false
KG_APP_ORIGIN=
KG_DRIVE_DB_HOST=
KG_DRIVE_DB_PORT=
KG_DRIVE_DB_PASSWORD=
KG_VAULT_DB_PASSWORD=
KG_DRIVE_ENCRYPTION_KEY_BASE64=
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
# Optional PEM trust certificate from the Supabase dashboard; never disable TLS verification.
KG_DB_CA_PEM=
